# Copy this file to `key.properties` (same folder) and fill in real values to
# sign a release build. `key.properties` is git-ignored — never commit it.
#
# Generate a keystore (one-time), from the `android/` folder:
#   keytool -genkey -v -keystore knb-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias knb
#
# Then point storeFile at it (path relative to android/app or absolute):
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=knb
storeFile=../knb-release.jks
